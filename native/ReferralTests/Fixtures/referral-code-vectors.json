{
  "description": "Shared parity vectors for referral codes (docs/superpowers/specs/2026-10-03-referral-program-design.md §2, §3, §5.1, §10). Loaded by backend-workers/tests/referralCode.test.cjs and root __tests__/bookingValidateReferralWorkers.test.js (the Worker's cleanReferralCode), and meant for native/ReferralTests (NativeReferrals.encodeCode / normalizeCode). encode: bytesHex is the input byte array as hex, most significant byte first; expect null means encodeCode returns nil. normalize: input null is a nil String?; expect null means the code is rejected (nil on the device, the key dropped on the Worker). jsOnly vectors exercise inputs Swift's typed API cannot express (non-strings); Swift skips them.",
  "alphabet": "0123456789abcdefghjkmnpqrstvwxyz",
  "codeByteCount": 10,
  "codeLength": 16,
  "pattern": "^[0-9a-hjkmnp-tv-z]{16}$",
  "encode": [
    { "name": "ten 0x00 bytes", "bytesHex": "00000000000000000000", "expect": "0000000000000000" },
    { "name": "ten 0xFF bytes", "bytesHex": "ffffffffffffffffffff", "expect": "zzzzzzzzzzzzzzzz" },
    { "name": "first half of the alphabet", "bytesHex": "00443214c74254b635cf", "expect": "0123456789abcdef" },
    { "name": "second half of the alphabet", "bytesHex": "84653a56d7c675be77df", "expect": "ghjkmnpqrstvwxyz" },
    { "name": "bytes 01 through 0a", "bytesHex": "0102030405060708090a", "expect": "041061050r3gg28a" },
    { "name": "mixed bytes", "bytesHex": "deadbeef001122334455", "expect": "vtpvxvr024h36h2n" },
    { "name": "no bytes", "bytesHex": "", "expect": null },
    { "name": "nine bytes", "bytesHex": "000000000000000000", "expect": null },
    { "name": "eleven bytes", "bytesHex": "0000000000000000000000", "expect": null }
  ],
  "normalize": [
    { "name": "canonical code", "input": "0123456789abcdef", "expect": "0123456789abcdef" },
    { "name": "every letter in the alphabet", "input": "ghjkmnpqrstvwxyz", "expect": "ghjkmnpqrstvwxyz" },
    { "name": "uppercase is lowercased", "input": "0123456789ABCDEF", "expect": "0123456789abcdef" },
    { "name": "mixed case is lowercased", "input": "GhJkMnPqRsTvWxYz", "expect": "ghjkmnpqrstvwxyz" },
    { "name": "surrounding spaces are trimmed", "input": "  0123456789abcdef  ", "expect": "0123456789abcdef" },
    { "name": "tabs and newlines are trimmed", "input": "\t0123456789abcdef\r\n", "expect": "0123456789abcdef" },
    { "name": "no-break spaces are trimmed", "input": " 0123456789abcdef ", "expect": "0123456789abcdef" },
    { "name": "trim then lowercase", "input": " \nVTPVXVR024H36H2N\t ", "expect": "vtpvxvr024h36h2n" },
    { "name": "rejects i", "input": "0123456789abcdei", "expect": null },
    { "name": "rejects l", "input": "0123456789abcdel", "expect": null },
    { "name": "rejects o", "input": "0123456789abcdeo", "expect": null },
    { "name": "rejects u", "input": "0123456789abcdeu", "expect": null },
    { "name": "rejects uppercase I, L, O and U", "input": "ILOU456789abcdef", "expect": null },
    { "name": "rejects 15 characters", "input": "0123456789abcde", "expect": null },
    { "name": "rejects 17 characters", "input": "0123456789abcdef0", "expect": null },
    { "name": "rejects an internal space", "input": "0123456 89abcdef", "expect": null },
    { "name": "rejects Crockford hyphen groups", "input": "0123-4567-89ab-cdef", "expect": null },
    { "name": "rejects punctuation", "input": "0123456789abcde!", "expect": null },
    { "name": "rejects a URL-encoded character", "input": "0123456789abc%20", "expect": null },
    { "name": "rejects a zero-width space (not trimmed)", "input": "​0123456789abcdef", "expect": null },
    { "name": "rejects the Kelvin sign even though it lowercases to k", "input": "K123456789abcdef", "expect": null },
    { "name": "rejects full-width digits", "input": "０123456789abcdef", "expect": null },
    { "name": "rejects an accented letter", "input": "é123456789abcdef", "expect": null },
    { "name": "rejects an emoji", "input": "😀123456789abcdef", "expect": null },
    { "name": "rejects empty", "input": "", "expect": null },
    { "name": "rejects whitespace only", "input": " \t\n ", "expect": null },
    { "name": "rejects nil", "input": null, "expect": null },
    { "name": "rejects a number", "input": 1234567890123456, "expect": null, "jsOnly": true },
    { "name": "rejects an array", "input": ["0123456789abcdef"], "expect": null, "jsOnly": true },
    { "name": "rejects an object", "input": { "code": "0123456789abcdef" }, "expect": null, "jsOnly": true },
    { "name": "rejects true", "input": true, "expect": null, "jsOnly": true },
    { "name": "rejects false", "input": false, "expect": null, "jsOnly": true }
  ]
}
